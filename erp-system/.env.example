# ============================================================
#  ACADEMIA ERP - ENVIRONMENT CONFIGURATION
#  Copy this file to .env and fill in your credentials
# ============================================================

# -------------------------------------------------------
# MONGODB ATLAS CONNECTION STRING
# Steps to get this:
# 1. Go to https://cloud.mongodb.com
# 2. Create a free cluster (M0)
# 3. Click "Connect" → "Connect your application"
# 4. Copy the connection string and replace <password> with your DB user password
# 5. Replace <dbname> with "academia_erp"
# -------------------------------------------------------
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/academia_erp?retryWrites=true&w=majority

# -------------------------------------------------------
# JWT SECRET - Use a long random string (min 32 chars)
# Generate one at: https://generate-secret.vercel.app/64
# -------------------------------------------------------
JWT_SECRET=your_super_secret_jwt_key_replace_this_with_something_long_and_random

# JWT Token expiry (7d = 7 days)
JWT_EXPIRES_IN=7d

# -------------------------------------------------------
# SERVER CONFIG
# -------------------------------------------------------
PORT=5000
NODE_ENV=development

# -------------------------------------------------------
# FRONTEND URL (for CORS) - Change this when deploying
# During local dev: http://localhost:3000 or http://127.0.0.1:5500
# After Netlify deploy: https://your-site-name.netlify.app
# -------------------------------------------------------
FRONTEND_URL=http://localhost:3000

# -------------------------------------------------------
# ADMIN SEED CREDENTIALS
# The admin account is auto-created on first server start
# Change these before deploying!
# -------------------------------------------------------
ADMIN_EMAIL=admin@academia.edu
ADMIN_PASSWORD=Admin@123456
ADMIN_NAME=System Administrator
